{
  "name": "obsidian-live-share-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "obsidian-live-share-relay": "bin/relay.mjs"
  },
  "files": [
    "dist",
    "bin",
    ".env.example",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "prepack": "npm run build",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:service": "npm run build && node scripts/package-smoke.mjs --service"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.3",
    "level": "^8.0.1",
    "lib0": "^0.2.97",
    "minimatch": "^10.2.4",
    "nanoid": "^5.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ws": "^8.5.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.18",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.0"
  }
}
